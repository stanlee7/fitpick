# FitPick 측정(Analytics) 환경변수 — 이 파일을 .env.local 로 복사해서 값을 채우세요.
# (로컬 개발용. Vercel은 대시보드 Settings > Environment Variables 에 같은 키로 등록)

# GA4 측정 ID (analytics.google.com 에서 발급, G-XXXXXXXXXX 형식)
# 비워두면 GA4 추적이 비활성화됩니다.
NEXT_PUBLIC_GA_ID=

# 피드백 폼 URL (Google Forms 등). 비워두면 피드백 버튼이 숨겨집니다.
NEXT_PUBLIC_FEEDBACK_URL=

# 공유 제안서 링크의 기준 도메인 (예: https://fitpick-nine.vercel.app)
# 데스크톱 앱(file://)에서 "공유 링크 복사" 시 받는 사람이 열 수 있는 웹 주소로 만들기 위해 사용.
# 비워두면 웹은 현재 origin, 데스크톱은 운영 주소로 자동 대체됩니다.
NEXT_PUBLIC_SITE_URL=
